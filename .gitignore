# Rust / maturin build output
/target/
target/
/dist/
dist/
*.whl
*.so
*.pyd
*.dll
*.dylib
*.egg-info/

# Python
__pycache__/
*.py[cod]
.pytest_cache/
.mypy_cache/
.ruff_cache/
.venv/
.venv*/
venv/
