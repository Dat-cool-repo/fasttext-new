+        // [fasttext-python-bindings patch] The 10 blocks are independent (one RNG each), so
+        // large matrices fill them in parallel on the rayon pool (C++ also initialises with
+        // one thread per block). The values are identical to the sequential loop.
+        if block_size == 0 || total < 1 << 20 {
+            for block in 0..10 {
+                let start = block_size * block;
+                let end = if block == 9 {
+                    total
+                } else {
+                    (block_size * (block + 1)).min(total)
+                };
+                fill(block, &mut data[start..end]);
+            }
+        } else {
+            use rayon::prelude::*;
+            let (head, last) = data.split_at_mut(block_size * 9);
+            let mut chunks: Vec<&mut [f32]> = head.chunks_mut(block_size).collect();
+            chunks.push(last);
+            chunks
+                .into_par_iter()
+                .enumerate()
+                .for_each(|(block, chunk)| fill(block, chunk));
         }
     }
 
