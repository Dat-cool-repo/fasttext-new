diff --git a/src/dictionary.rs b/src/dictionary.rs
--- a/src/dictionary.rs
+++ b/src/dictionary.rs
@@ -1,6 +1,32 @@
 // Dictionary: tokenization, vocabulary, subwords, word n-grams, hash table
 
 use std::collections::HashMap;
+
+/// Cheap multiplicative hasher for the `i32` keys of
+/// `pruneidx` (looked up once per character n-gram of every OOV token in `.ftz` models;
+/// SipHash made tokenization ~2x slower than C++'s `std::unordered_map`).
+#[derive(Default, Clone, Copy)]
+pub struct IntHasher(u64);
+
+impl std::hash::Hasher for IntHasher {
+    #[inline]
+    fn finish(&self) -> u64 {
+        self.0
+    }
+    #[inline]
+    fn write(&mut self, bytes: &[u8]) {
+        for &b in bytes {
+            self.0 = (self.0.rotate_left(5) ^ b as u64).wrapping_mul(0x517c_c1b7_2722_0a95);
+        }
+    }
+    #[inline]
+    fn write_i32(&mut self, i: i32) {
+        self.0 = (i as u32 as u64).wrapping_mul(0x9e37_79b9_7f4a_7c15);
+    }
+}
+
+/// Pruned n-gram bucket -> compact row map.
+pub type PruneIdx = HashMap<i32, i32, std::hash::BuildHasherDefault<IntHasher>>;
 use std::io::{Read, Write};
 use std::sync::Arc;
 
