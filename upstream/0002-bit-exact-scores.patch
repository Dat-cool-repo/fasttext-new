 /// The small addend prevents log(0) = -∞.  C++ uses `1e-5` (double literal)
 /// but the result is truncated to `real` (float); using `1e-5_f32` here
 /// produces the same output since the difference is below f32 epsilon.
+///
+/// Computed in `f64` exactly like C++
+/// (`std::log(x + 1e-5)` with a double literal, then narrowed), so that scores, ties and
+/// threshold comparisons are bit-identical to C++ fastText.
 #[inline]
 pub fn std_log(x: f32) -> f32 {
-    (x + 1e-5_f32).ln()
+    ((x as f64) + 1e-5).ln() as f32
+}
+
+// libstdc++-compatible binary heap.
+//
+// C++ fastText keeps its top-k candidates in a `std::vector` managed with
+// `std::push_heap` / `std::pop_heap` / `std::sort_heap` and the comparator
+// `l.first > r.first`. Re-implementing the exact libstdc++ algorithms makes the
+// order of *tied* predictions (common with the table-based sigmoid of OVA / NS
+// losses) identical to the C++ package.
+
+#[inline]
+fn heap_cmp(l: &(f32, i32), r: &(f32, i32)) -> bool {
+    l.0 > r.0
+}
+
+/// libstdc++ `__push_heap`.
+fn heap_sift_up(h: &mut [(f32, i32)], mut hole: usize, top: usize, value: (f32, i32)) {
+    while hole > top {
+        let parent = (hole - 1) / 2;
+        if !heap_cmp(&h[parent], &value) {
+            break;
+        }
+        h[hole] = h[parent];
+        hole = parent;
+    }
+    h[hole] = value;
+}
+
+/// libstdc++ `__adjust_heap` (`len >= 1`).
+fn heap_adjust(h: &mut [(f32, i32)], mut hole: usize, len: usize, value: (f32, i32)) {
+    let top = hole;
+    let mut second = hole;
+    while second < (len - 1) / 2 {
+        second = 2 * (second + 1);
+        if heap_cmp(&h[second], &h[second - 1]) {
+            second -= 1;
+        }
+        h[hole] = h[second];
+        hole = second;
+    }
+    if len & 1 == 0 && second == (len - 2) / 2 {
+        second = 2 * (second + 1);
+        h[hole] = h[second - 1];
+        hole = second - 1;
+    }
+    heap_sift_up(h, hole, top, value);
+}
+
+/// libstdc++ `__pop_heap(first, first + last, first + last)`.
+fn heap_pop_to(h: &mut [(f32, i32)], last: usize) {
+    let value = h[last];
+    h[last] = h[0];
+    heap_adjust(h, 0, last, value);
+}
+
+/// `std::push_heap` on the whole vector (new element already pushed at the back).
+pub(crate) fn cpp_push_heap(h: &mut [(f32, i32)]) {
+    let n = h.len();
+    if n > 1 {
+        let v = h[n - 1];
+        heap_sift_up(h, n - 1, 0, v);
+    }
+}
+
+/// `std::pop_heap` (moves the front to the back; caller pops it).
+pub(crate) fn cpp_pop_heap(h: &mut [(f32, i32)]) {
+    let n = h.len();
+    if n > 1 {
+        heap_pop_to(h, n - 1);
+    }
+}
+
+/// `std::sort_heap`: result is sorted by descending score.
+pub(crate) fn cpp_sort_heap(h: &mut [(f32, i32)]) {
+    let mut last = h.len();
+    while last > 1 {
+        last -= 1;
+        heap_pop_to(h, last);
+    }
 }
 
