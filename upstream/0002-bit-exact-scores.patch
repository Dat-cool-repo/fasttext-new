@@ -62,6 +63,24 @@
 /// Dispatch dot product to best available implementation.
 #[inline]
 pub(crate) fn dot_impl(a: &[f32], b: &[f32]) -> f32 {
+    // Sequential scalar accumulation, exactly like C++
+    // `DenseMatrix::dotRow` (`d += at(i, j) * vec[j]`). The SIMD/FMA variants below reorder
+    // and fuse the additions, which changes results in the last bits and can flip the order
+    // of near-tied predictions relative to the C++ package. Output dot products are a small
+    // share of inference time (hidden-layer averaging dominates).
+    #[cfg(not(feature = "simd-dot"))]
+    {
+        dot_scalar(a, b)
+    }
+    #[cfg(feature = "simd-dot")]
+    {
+        dot_impl_simd(a, b)
+    }
+}
+
+#[cfg(feature = "simd-dot")]
+#[inline]
+fn dot_impl_simd(a: &[f32], b: &[f32]) -> f32 {
     #[cfg(target_arch = "aarch64")]
     {
         neon::dot(a, b)
