+    /// C++ `startThreads` progress loop: with `verbose > 1`,
+    /// print a `Progress:` line to stderr every 100 ms until all workers have finished.
+    pub(super) fn wait_with_progress<T>(
+        args: &Args,
+        ntokens: i64,
+        handles: &[std::thread::ScopedJoinHandle<'_, T>],
+        token_count: &AtomicI64,
+        progress_loss: &AtomicU32,
+        start: Instant,
+    ) {
+        if args.verbose <= 1 {
+            return;
+        }
+        while !handles.iter().all(|h| h.is_finished()) {
+            std::thread::sleep(Duration::from_millis(100));
+            let loss = f32::from_bits(progress_loss.load(Ordering::Relaxed));
+            if loss >= 0.0 {
+                let tc = token_count.load(Ordering::Relaxed);
+                let progress = tc as f64 / (args.epoch as f64 * ntokens as f64);
+                eprint!("\r{}", Self::progress_info(args, progress, loss, tc, start));
+            }
+        }
+    }
+
+    /// Final C++ progress line (`verbose > 0`).
+    pub(super) fn print_final_progress(
+        args: &Args,
+        token_count: &AtomicI64,
+        progress_loss: &AtomicU32,
+        start: Instant,
+    ) {
+        if args.verbose > 0 {
+            let loss = f32::from_bits(progress_loss.load(Ordering::Relaxed));
+            let tc = token_count.load(Ordering::Relaxed);
+            eprintln!("\r{}", Self::progress_info(args, 1.0, loss, tc, start));
+        }
+    }
+
+    /// C++ `FastText::printInfo`.
+    fn progress_info(args: &Args, progress: f64, loss: f32, tc: i64, start: Instant) -> String {
+        let t = start.elapsed().as_secs_f64();
+        let lr = args.lr * (1.0 - progress);
+        let (mut pct, mut wst, mut eta) = (progress, 0.0f64, 2_592_000i64);
+        if progress > 0.0 && t >= 0.0 {
+            pct = progress * 100.0;
+            eta = (t * (100.0 - pct) / pct) as i64;
+            wst = tc as f64 / t / args.thread.max(1) as f64;
+        }
+        format!(
+            "Progress: {:5.1}% words/sec/thread: {:7} lr: {:9.6} avg.loss: {:9.6} ETA: {:3}h{:2}m{:2}s",
+            pct,
+            wst as i64,
+            lr,
+            loss,
+            eta / 3600,
+            (eta % 3600) / 60,
+            eta % 60
+        )
+    }
