+            // Pretrained rows were read (and their words
+            // added to the dictionary) before the matrix was sized, like C++
+            // `getInputMatrixFromFile`.
+            for (word, vec) in pretrained.unwrap_or_default() {
+                if let Some(idx) = dict.get_id(word) {
+                    if idx < dict.nwords() {
+                        m.row_mut(idx as i64).copy_from_slice(vec);
+                    }
+                }
             }
