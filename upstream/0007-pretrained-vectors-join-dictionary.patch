+        // pretrained `.vec` file to the dictionary (`threshold(1, 0)` + `init()`), so that
+        // pretrained words missing from (or rare in) the training data still get their vectors.
+        let pretrained = if args.pretrained_vectors.as_os_str().is_empty() {
